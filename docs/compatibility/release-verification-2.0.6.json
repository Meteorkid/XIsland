  "peerAuthenticationFixes": {
    "defect1_uidReadFromWrongConstant": {
      "symptom": "Every connection rejected; panel receives no agent messages at all.",
      "cause": "Peer UID was read via getsockopt(SOL_LOCAL, 0x005). On macOS 0x005 is LOCAL_PEEREUUID (peer UUID), not a UID; sys/un.h defines no LOCAL_PEEREUID. The first 4 bytes of the peer UUID were compared against the real UID and never matched.",
      "measuredBefore": {
        "getsockopt_0x005_value": 2024211864,
        "realUID": 501
      },
      "fix": "Use getpeereid(3) to read the peer effective UID.",
      "regressionTest": "Tests/TowerIslandTests/SocketServerAcceptTests.swift::testPeerIdentityReadsRealUIDNotPeerUUIDPrefix",
      "regressionTestVerifiedToFail": true
    },
    "defect2_exitedPeerTreatedAsUntrusted": {
      "symptom": "All non-interactive hooks silently dropped; interactive approvals still worked.",
      "cause": "Non-interactive hooks send and exit immediately. When the server accepts, the peer is often already gone, so LOCAL_PEERPID fails with ENOTCONN (measured errno 57) and the executable path cannot be resolved. The original guard treated a missing path as untrusted and closed the connection.",
      "measuredBefore": {
        "LOCAL_PEERPID_rc": -1,
        "LOCAL_PEERPID_errno": 57,
        "getpeereid_rc": 0,
        "getpeereid_uid": 501
      },
      "fix": "Treat an unresolvable executable path as a UID-only decision rather than a rejection. UID is snapshotted by the kernel and remains reliable.",
      "regressionTests": [
        "Tests/TowerIslandTests/SocketServerAcceptTests.swift::testExitedPeerWithoutPathIsStillTrusted",
        "Tests/TowerIslandTests/SocketServerAcceptTests.swift::testResolvableUnapprovedPathIsStillUntrusted"
      ]
    },
